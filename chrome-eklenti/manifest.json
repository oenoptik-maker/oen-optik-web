{
  "manifest_version": 3,
  "name": "OEN Optik - UTS Aktarım",
  "version": "3.0",
  "description": "UTS sayfasına buton ekler, seçili ürünleri OEN Optik'e aktarır",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": [
    "*://oenoptik.com/*",
    "*://www.oenoptik.com/*",
    "*://oen-optik-web.vercel.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["*://utsuygulama.saglik.gov.tr/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
