{
  "manifest_version": 3,
  "name": "OEN Optik - UTS Aktarım",
  "version": "1.0",
  "description": "UTS sayfasından seçili ürünleri OEN Optik'e aktarır",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
