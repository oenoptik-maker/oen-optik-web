{
  "manifest_version": 3,
  "name": "OEN Optik - UTS Aktarım",
  "version": "4.0",
  "description": "UTS sayfasına buton ekler, seçili ürünleri OEN Optik'e aktarır",
  "permissions": ["storage"],
  "host_permissions": [
    "*://oen-optik-web.vercel.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["*://utsuygulama.saglik.gov.tr/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://oen-optik-web.vercel.app/admin.html*"],
      "js": ["admin-content.js"],
      "run_at": "document_idle"
    }
  ]
}
