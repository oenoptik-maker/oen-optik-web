{
  "manifest_version": 3,
  "name": "OEN Optik - UTS Aktarim",
  "version": "6.0",
  "description": "UTS sayfasina buton ekler, secili urunleri OEN Optik'e aktarir",
  "permissions": ["activeTab", "scripting", "tabs", "storage"],
  "host_permissions": [
    "*://oenoptik.com/*",
    "*://www.oenoptik.com/*",
    "*://oen-optik-web.vercel.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["*://utsuygulama.saglik.gov.tr/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://oen-optik-web.vercel.app/*"],
      "js": ["admin-content.js"],
      "run_at": "document_idle"
    }
  ]
}
